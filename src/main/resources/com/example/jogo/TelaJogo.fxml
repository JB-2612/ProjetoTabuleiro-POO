<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.jogo.ui.TelaJogoController"
            prefHeight="850.0" prefWidth="1300.0">

    <center>
        <ScrollPane fitToWidth="false" fitToHeight="false" pannable="true"
                    style="-fx-background: #f4f4f4;">
            <GridPane fx:id="tabuleiroPane" hgap="12" vgap="20" style="-fx-padding:20;"/>
        </ScrollPane>
    </center>

    <right>
        <VBox spacing="10" prefWidth="240" style="-fx-padding:15;">
            <Label fx:id="lblVez" text="Vez de: -" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <Label fx:id="lblDados" text="Soma dos dados: -"/>
            <TextField fx:id="txtCasaDebug" promptText="Casa destino (debug)" visible="false"/>
            <Button fx:id="btnJogar" text="Jogar" onAction="#jogar"
                    style="-fx-font-size: 14; -fx-padding: 8 20 8 20;"/>
        </VBox>
    </right>

    <bottom>
        <TextArea fx:id="txtLog" editable="false" prefRowCount="6" wrapText="true"/>
    </bottom>

</BorderPane>